# Environment: Development
# Description: Environment variables for development environment
# Note: Do not commit sensitive information to version control
# VITE_SUMAQAGRO_PLATFORM_API_URL version to be used when the RESTful API is running on port 5222, otherwise use the one for port 3000 (json-server Fake API)
# VITE_SUMAQAGRO_PLATFORM_API_URL="http://localhost:5222/api/v1"
VITE_SUMAQAGRO_PLATFORM_API_URL="http://localhost:3000/api/v1"
# Profiles
VITE_PROFILES_ENDPOINT_PATH="/profiles"
VITE_COOPERATIVES_ENDPOINT_PATH="/cooperatives"
VITE_COOPERATIVE_MEMBERS_ENDPOINT_PATH="/cooperative-members"
VITE_COOPERATIVE_DASHBOARDS_ENDPOINT_PATH="/cooperative-dashboards"
VITE_AGRONOMIST_ASSIGNMENTS_ENDPOINT_PATH="/agronomist-assignments"
# Field Management
VITE_FIELD_PLOTS_ENDPOINT_PATH="/field-plots"
VITE_CROP_CAMPAIGNS_ENDPOINT_PATH="/crop-campaigns"
VITE_CAMPAIGN_LEDGERS_ENDPOINT_PATH="/campaign-ledgers"
# Crop Health
VITE_SATELLITE_OBSERVATIONS_ENDPOINT_PATH="/satellite-observations"
VITE_AGROCLIMATIC_ALERTS_ENDPOINT_PATH="/agroclimatic-alerts"
VITE_PEST_REPORTS_ENDPOINT_PATH="/pest-reports"
VITE_FIELD_INSPECTIONS_ENDPOINT_PATH="/field-inspections"
VITE_TECHNICAL_PRESCRIPTIONS_ENDPOINT_PATH="/technical-prescriptions"
# Harvest Certification
VITE_HARVEST_BATCHES_ENDPOINT_PATH="/harvest-batches"
VITE_QUALITY_CERTIFICATES_ENDPOINT_PATH="/quality-certificates"
# VITE_PRIME_UI_LICENSE_KEY is the license key for the Prime UI library (free community key from https://primeui.store).
VITE_PRIME_UI_LICENSE_KEY=""
